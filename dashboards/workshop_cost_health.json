{
  "datasets": [
    {
      "name": "ds_cost",
      "displayName": "工作坊每日成本 (Workshop cost by day)",
      "queryLines": [
        "WITH resources AS (\n",
        "  SELECT pipeline_id AS resource_id, 'pipeline' AS resource_type,\n",
        "         max_by(name, change_time) AS resource_name, max_by(created_by, change_time) AS owner\n",
        "  FROM hytech_ws_catalog.ops.pipelines GROUP BY pipeline_id\n",
        "  UNION ALL\n",
        "  SELECT job_id, 'job', max_by(name, change_time), max_by(creator_user_name, change_time)\n",
        "  FROM hytech_ws_catalog.ops.jobs GROUP BY job_id\n",
        "),\n",
        "workshop AS (\n",
        "  SELECT * FROM resources\n",
        "  WHERE resource_name ILIKE '%trade_lakehouse%' OR resource_name ILIKE '%daily_trading_reporting%' OR resource_name ILIKE '%hytech_ws_%'\n",
        ")\n",
        "SELECT u.usage_date,\n",
        "       u.billing_origin_product                                          AS product,\n",
        "       w.resource_type,\n",
        "       w.resource_name,\n",
        "       w.owner,\n",
        "       CAST(sum(u.usage_quantity) AS DECIMAL(18, 3))                     AS dbus,\n",
        "       CAST(sum(u.usage_quantity * p.pricing.default) AS DECIMAL(18, 2)) AS list_cost_usd\n",
        "FROM hytech_ws_catalog.ops.billing_usage u\n",
        "JOIN workshop w\n",
        "  ON w.resource_id = coalesce(u.usage_metadata.dlt_pipeline_id, u.usage_metadata.job_id)\n",
        "JOIN hytech_ws_catalog.ops.list_prices p\n",
        "  ON u.sku_name = p.sku_name\n",
        " AND u.usage_start_time >= p.price_start_time\n",
        " AND (p.price_end_time IS NULL OR u.usage_start_time < p.price_end_time)\n",
        "WHERE u.usage_date >= current_date() - INTERVAL 30 DAYS\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_job_runs",
      "displayName": "工作坊作业运行 (Workshop job runs)",
      "queryLines": [
        "WITH jobs AS (\n",
        "  SELECT job_id, max_by(name, change_time) AS resource_name\n",
        "  FROM hytech_ws_catalog.ops.jobs GROUP BY job_id\n",
        "),\n",
        "task_failures AS (\n",
        "  -- a run that ends \"Succeeded with failures\" still reports SUCCEEDED, so count failed tasks per run\n",
        "  SELECT job_run_id, count_if(result_state = 'FAILED') AS failed_tasks\n",
        "  FROM hytech_ws_catalog.ops.job_task_run_timeline\n",
        "  WHERE period_start_time >= current_date() - INTERVAL 30 DAYS\n",
        "  GROUP BY job_run_id\n",
        ")\n",
        "SELECT j.resource_name                                  AS job_name,\n",
        "       r.run_id,\n",
        "       min(r.period_start_time)                         AS started_at,\n",
        "       timestampdiff(SECOND, min(r.period_start_time), max(r.period_end_time)) AS duration_s,\n",
        "       coalesce(max_by(r.result_state, r.period_end_time), 'RUNNING') AS result_state,\n",
        "       max(r.trigger_type)                              AS trigger_type,\n",
        "       coalesce(max(tf.failed_tasks), 0)                AS failed_tasks,\n",
        "       CASE WHEN max_by(r.result_state, r.period_end_time) IN ('FAILED', 'ERROR', 'TIMED_OUT')\n",
        "              OR coalesce(max(tf.failed_tasks), 0) > 0\n",
        "            THEN 1 ELSE 0 END                           AS is_failed\n",
        "FROM hytech_ws_catalog.ops.job_run_timeline r\n",
        "JOIN jobs j USING (job_id)\n",
        "LEFT JOIN task_failures tf ON tf.job_run_id = r.run_id\n",
        "WHERE (j.resource_name ILIKE '%trade_lakehouse%' OR j.resource_name ILIKE '%daily_trading_reporting%' OR j.resource_name ILIKE '%hytech_ws_%')\n",
        "  AND r.period_start_time >= current_date() - INTERVAL 30 DAYS\n",
        "GROUP BY j.resource_name, r.run_id\n",
        "ORDER BY started_at DESC\n"
      ]
    },
    {
      "name": "ds_task_runs",
      "displayName": "工作坊任务运行 (Workshop task runs)",
      "queryLines": [
        "WITH jobs AS (\n",
        "  SELECT job_id, max_by(name, change_time) AS job_name\n",
        "  FROM hytech_ws_catalog.ops.jobs GROUP BY job_id\n",
        ")\n",
        "SELECT j.job_name,\n",
        "       t.task_key,\n",
        "       t.run_id                                           AS task_run_id,\n",
        "       max(t.execution_duration_seconds)                  AS exec_s,\n",
        "       max_by(t.result_state, t.period_end_time)          AS result_state\n",
        "FROM hytech_ws_catalog.ops.job_task_run_timeline t\n",
        "JOIN jobs j USING (job_id)\n",
        "WHERE j.job_name ILIKE '%daily_trading_reporting%'\n",
        "  AND t.period_start_time >= current_date() - INTERVAL 30 DAYS\n",
        "GROUP BY j.job_name, t.task_key, t.run_id\n"
      ]
    },
    {
      "name": "ds_pipeline_updates",
      "displayName": "工作坊管道更新 (Workshop pipeline updates)",
      "queryLines": [
        "WITH pipelines AS (\n",
        "  SELECT pipeline_id, max_by(name, change_time) AS pipeline_name\n",
        "  FROM hytech_ws_catalog.ops.pipelines GROUP BY pipeline_id\n",
        ")\n",
        "SELECT p.pipeline_name,\n",
        "       min(t.period_start_time)                                                AS started_at,\n",
        "       timestampdiff(SECOND, min(t.period_start_time), max(t.period_end_time)) AS duration_s,\n",
        "       max(t.update_type)                                                      AS update_type,\n",
        "       max(t.trigger_type)                                                     AS trigger_type,\n",
        "       coalesce(max_by(t.result_state, t.period_end_time), 'RUNNING')          AS result_state,\n",
        "       t.update_id\n",
        "FROM hytech_ws_catalog.ops.pipeline_update_timeline t\n",
        "JOIN pipelines p USING (pipeline_id)\n",
        "WHERE p.pipeline_name ILIKE '%trade_lakehouse%'\n",
        "  AND t.period_start_time >= current_date() - INTERVAL 30 DAYS\n",
        "GROUP BY p.pipeline_name, t.update_id\n",
        "ORDER BY started_at DESC\n"
      ]
    }
  ],
